MEDWATCH_ENV=dev
MEDWATCH_LOG_LEVEL=INFO
MEDWATCH_LOG_JSON=false
MEDWATCH_AZURE_MOCK=false
MEDWATCH_POSE_BACKEND=yolo

# Alertas: severidade mínima para virar alerta (info | low | medium | high | critical)
MEDWATCH_ALERT_MIN_SEVERITY=medium
MEDWATCH_ALERT_COOLDOWN_MINUTES=15
# Webhook opcional (Teams Workflows, Slack ou Discord); formato: generic | teams | slack | discord
MEDWATCH_ALERT_WEBHOOK_URL=
MEDWATCH_ALERT_WEBHOOK_FORMAT=generic

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_LANGUAGE=pt-BR
AZURE_LANGUAGE_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=
