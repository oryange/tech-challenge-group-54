    "sentences": [
      {
        "text": "Bom dia. Como a senhora passou a noite?",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Bom dia, doutor.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Passei bem, dormi a noite toda.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Sentiu alguma falta de ar ou cansaço para fazer as coisas?",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Não, não tenho falta de ar.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Ontem caminhei duas vezes pelo corredor e me senti disposta.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "E dor no peito ou tontura?",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Nenhuma dor no peito.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Também não tive tontura.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Está se alimentando bem?",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Estou, sim. Comi tudo no almoço e o apetite voltou.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Ótimo. Vamos manter a medicação e reavaliar amanhã.",
        "sentiment": "positive",
        "scores": {
          "positive": 0.6,
          "neutral": 0.35,
          "negative": 0.05
        },
        "opinions": []
      },
      {
        "text": "Combinado, doutor. Obrigada.",
        "sentiment": "positive",
